{
  "compilerOptions": {
    /* Saída */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Ambiente / módulos (Node + CommonJS via nodenext) */
    "target": "ES2021",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2021"],
    "types": ["node"],
    "esModuleInterop": true,
    

    /* Necessário para os decorators do TypeORM e class-validator */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* Checagem de tipos */
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,

  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
